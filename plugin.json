{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "codex-continuer",
  "version": "0.5.1",
  "description": "Windows 预览版：Codex 额度监测、原聊天接续与任务管理",
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "interface": {
        "displayName": "Continuer",
        "shortDescription": "额度恢复，让项目继续向前",
        "longDescription": "查看本机 Codex 额度与任务计划，选择持续工作，额度恢复后自动接续。所有控制集成在跟随 Codex 的原生悬浮挂件中。",
        "developerName": "Continuer Local",
        "category": "Productivity",
        "capabilities": [
          "Read",
          "Write"
        ],
        "defaultPrompt": [
          "打开 Continuer 额度与工作挂件",
          "查看当前额度和任务进度"
        ],
        "brandColor": "#c6d79e",
        "composerIcon": "./desktop/icon.png",
        "logo": "./desktop/icon.png"
      }
    }
  }
}
